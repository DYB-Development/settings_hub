<%= ui_page(max_width: :xl) do %>
  <%= ui_page_header(title: "Settings") %>

  <%= ui_grid(cols: { default: 1, lg: 2 }, gap: :lg) do %>
    <%= ui_section do %>
      <% @areas.each do |area, sections| %>
        <section aria-label="<%= area.to_s.titleize %>">
          <%= ui_section(title: area.to_s.titleize) do %>
            <%= ui_panel do %>
              <nav aria-label="Settings">
                <% sections.each do |section| %>
                  <%= link_to section.title, section.at || section_path(section.key), "aria-current": ("page" if section == @section) %>
                <% end %>
              </nav>
            <% end %>
          <% end %>
        </section>
      <% end %>
    <% end %>

    <%= ui_section do %>
      <%= ui_alert(message: @refusal, type: :error) if @refusal %>
      <%= render partial: @section.renders, locals: {person: @person, account: @account, selection: @selection || {}, **(@section_addresses || {})} if @section %>
    <% end %>
  <% end %>
<% end %>
